{
  "name": "seo-opt-chrome-plugin",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-chrome.mjs",
    "dev:chrome": "node scripts/dev-chrome.mjs",
    "dev:chrome:debug": "SEO_OPT_OPEN_DEVTOOLS=1 SEO_OPT_WXT_DEBUG=1 node scripts/dev-chrome.mjs",
    "dev:chrome:manual": "SEO_OPT_MANUAL_CHROME=1 node scripts/dev-chrome.mjs",
    "dev:chrome:manual:restart": "SEO_OPT_MANUAL_CHROME=1 node scripts/dev-chrome.mjs --restart",
    "dev:chrome:restart": "node scripts/dev-chrome.mjs --restart",
    "dev:chrome:stop": "node scripts/dev-chrome.mjs --stop",
    "build": "wxt build -b chrome",
    "zip": "wxt zip -b chrome",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "store:screenshots": "SEO_OPT_STORE_ASSETS=1 npm run test:e2e",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "fast-xml-parser": "^5.10.1",
    "idb": "^8.0.3",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.28.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.1.4",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "web-ext": "^10.6.0",
    "wxt": "0.21.2"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
